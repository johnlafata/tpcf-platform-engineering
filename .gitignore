# Configuration backups
# config-backup/

env-creds/*/om-env.yml
env-creds/cf-groups.yml

# Extracted configurations (contains credentials)
# config-export/

# Sensitive files
*-secrets.yml
*.pem
*.key
*.crt

# Real per-foundation credential files (the -redacted templates are fine to commit)
env-creds/**/om-env.yml
env-creds/**/cf-mgmt-env.yml

# Real cf-groups.yml (the -redacted template is fine to commit). Not per-foundation --
# lives directly under env-creds/, shared across all environments.
env-creds/cf-groups.yml

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Old folders (keeping for reference, not committing changes)
sandbox-backup/

# Temporary files
*.tmp
*.log

**/*.pivotal
downloaded-products/**

certs/completed*.cnf
